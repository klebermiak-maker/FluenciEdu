{
  "entities": {
    "School": {
      "title": "School",
      "description": "Unidade escolar cadastrada no município de Itaúba - MT",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "municipio": { "type": "string" },
        "estado": { "type": "string" },
        "codigo": { "type": "string" },
        "responsavel": { "type": "string" },
        "email": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["nome", "municipio", "estado"]
    },
    "ClassRoom": {
      "title": "ClassRoom",
      "description": "Turma ou sala de aula de ensino fundamental",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "ano_serie": { "type": "string" },
        "turno": { "type": "string" },
        "professor_id": { "type": "string" },
        "escola_id": { "type": "string" },
        "ano_letivo": { "type": "number" },
        "created_at": { "type": "string" }
      },
      "required": ["nome", "ano_serie", "turno", "escola_id", "ano_letivo"]
    },
    "Student": {
      "title": "Student",
      "description": "Estudante dos anos iniciais do ensino fundamental",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "matricula": { "type": "string" },
        "data_nascimento": { "type": "string" },
        "turma_id": { "type": "string" },
        "escola_id": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["nome", "matricula", "data_nascimento", "turma_id", "escola_id"]
    },
    "Profile": {
      "title": "Profile",
      "description": "Perfil de usuário educador ou gestor municipal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "gestor", "professor"] },
        "escola_id": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["nome", "email", "role"]
    },
    "ReadingMaterial": {
      "title": "ReadingMaterial",
      "description": "Material de leitura para avaliação de fluência leitora",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "tipo": { "type": "string", "enum": ["palavras", "pseudopalavras", "texto_curto"] },
        "ano_escolar": { "type": "string" },
        "conteudo": { "type": "string" },
        "descricao": { "type": "string" },
        "is_exemplo": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["titulo", "tipo", "ano_escolar", "conteudo"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Registro de avaliação de gravação de leitura do estudante",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "escola_id": { "type": "string" },
        "professor_id": { "type": "string" },
        "professor_nome": { "type": "string" },
        "turma_id": { "type": "string" },
        "aluno_id": { "type": "string" },
        "material_id": { "type": "string" },
        "material_titulo": { "type": "string" },
        "material_tipo": { "type": "string", "enum": ["palavras", "pseudopalavras", "texto_curto"] },
        "material_conteudo_snapshot": { "type": "string" },
        "modalidade": { "type": "string", "enum": ["livre", "60_segundos"] },
        "data_inicio": { "type": "string" },
        "duracao_segundos": { "type": "number" },
        "audio_url": { "type": "string" },
        "audio_storage_path": { "type": "string" },
        "audio_mime_type": { "type": "string" },
        "audio_size_bytes": { "type": "number" },
        "observacoes": { "type": "string" },
        "status_armazenamento": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["escola_id", "turma_id", "aluno_id", "material_id", "material_conteudo_snapshot", "modalidade", "duracao_segundos"]
    }
  },
  "firestore": {
    "/schools/{schoolId}": {
      "schema": "School",
      "description": "Coleção de escolas municipais"
    },
    "/classes/{classId}": {
      "schema": "ClassRoom",
      "description": "Coleção de turmas escolares"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Coleção de alunos cadastrados"
    },
    "/profiles/{profileId}": {
      "schema": "Profile",
      "description": "Perfis de usuários do sistema"
    },
    "/reading_materials/{materialId}": {
      "schema": "ReadingMaterial",
      "description": "Materiais de leitura cadastrados"
    },
    "/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Gravações e avaliações de fluência leitora"
    }
  }
}
